#version 450

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba8) uniform image2D pixels;
layout(push_constant) uniform Parameters {
    uint width;
    uint height;
    float gamma;
} parameters;

void main() {
    ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    if (position.x >= int(parameters.width) || position.y >= int(parameters.height)) return;
    vec4 color = imageLoad(pixels, position);
    imageStore(pixels, position, vec4(pow(color.rgb, vec3(parameters.gamma)), color.a));
}
